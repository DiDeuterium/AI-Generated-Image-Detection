{
  "data": {
    "splits": "splits/train_val.csv",
    "image_dir": "dataset",
    "input_size": 224,
    "resize_size": 256,
    "num_workers": 8,
    "norm_stats": "fqm/configs/norm_stats.json",
    "jpeg_cache": "fqm/cache/val_jpeg_q75",
    "jpeg_quality": 75,
    "jpeg_subsampling": 2
  },
  "model": {
    "name": "efficientvim_m1",
    "num_classes": 2,
    "drop_path_rate": 0.0
  },
  "train": {
    "seed": 42,
    "epochs": 30,
    "updates_per_epoch": 100,
    "micro_batch": 32,
    "accum_steps": 2,
    "lr": 0.0003,
    "lr_start": 3e-06,
    "lr_final": 3e-06,
    "warmup_updates": 200,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-08,
    "label_smoothing": 0.0,
    "amp": true,
    "amp_dtype": "float16"
  },
  "output": {
    "root": "fqm/runs",
    "run_name": "efficientvim_m1_seed42"
  }
}
