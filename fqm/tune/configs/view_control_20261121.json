{
  "data": {
    "splits": "splits/train_val.csv",
    "image_dir": "dataset",
    "input_size": 320,
    "resize_size": 352,
    "num_workers": 2,
    "norm_stats": "fqm/configs/norm_stats.json",
    "jpeg_cache": "fqm/cache/val_jpeg_q75",
    "jpeg_quality": 75,
    "jpeg_subsampling": 2,
    "aug": {
      "mode": "native",
      "hflip": 0.5
    },
    "target_alignment": {
      "profiles": "fqm/runs/target_profile_20261121/profiles.json",
      "match_train": false,
      "select_every": 3,
      "select_legacy_strong": true
    }
  },
  "model": {
    "name": "efficientvim_m1",
    "num_classes": 2,
    "drop_path_rate": 0.0
  },
  "train": {
    "seed": 42,
    "epochs": 12,
    "updates_per_epoch": 100,
    "micro_batch": 16,
    "accum_steps": 4,
    "lr": 0.0003,
    "lr_start": 3e-06,
    "lr_final": 3e-06,
    "warmup_updates": 200,
    "weight_decay": 0.05,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "label_smoothing": 0.05,
    "loss": "ce",
    "mixup_alpha": 0.0,
    "cutmix_alpha": 0.0,
    "mix_prob": 1.0,
    "ema_decay": 0.99,
    "amp": true,
    "amp_dtype": "float16",
    "selection": "target_worst_acc",
    "fresh_output": true,
    "view_consistency_weight": 0.0
  },
  "output": {
    "root": "fqm/runs/tune",
    "run_name": "view_control_20261121"
  }
}
